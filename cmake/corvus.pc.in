# Relocatable: prefix is derived from this file's own location, so
# `cmake --install <build> --prefix <other>` (and moving the tree) stay valid.
prefix=${pcfiledir}/@CORVUS_PC_PREFIX_REL@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: corvus
Description: SIMD-vectorized statistical special functions
Version: @PROJECT_VERSION@
URL: https://github.com/OldCrow/corvus

Requires: libhwy
Libs: -L${libdir} -lcorvus
Cflags: -I${includedir} -std=c++20
